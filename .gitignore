# Godot 4 .gitignore

# Godot 4 specific ignores
.godot/
export.cfg
export_presets.cfg

# Imported files (those are generated by the engine)
*.import

# Godot Mono specific ignores (if using C#)
data_*/
mono/
.vscode/
.vs/
*.csproj
*.sln
*.userprefs
obj/
bin/

# Build artifacts (those can get quite big)
build/
dist/
export/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor backups
*~
*.bak
*.swp

# Local configuration
local_config.cfg

# Plugin specific ignores
addons/*/.git
